work state.\\nDo not need to propose any solutions or remediation steps at this stage.\" additional_kwargs={} response_metadata={} id='349e5fa6-c2ff-4421-ba90-cc11d0f97665'", "model": {"lc": 1, "type": "constructor", "id": ["langchain", "chat_models", "openai", "ChatOpenAI"], "kwargs": {"model_name": "kt-gpt-oss-rh014", "temperature": 0.0, "openai_api_key": {"lc": 1, "type": "secret", "id": ["OPENAI_API_KEY"]}, "openai_api_base": "https://dev.kora.kt.co.kr/v2", "request_timeout": 180.0, "max_retries": 2}, "name": "ChatOpenAI"}}
