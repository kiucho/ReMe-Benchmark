work state.\\nDo not need to propose any solutions or remediation steps at this stage.\" additional_kwargs={} response_metadata={} id='3af4143b-d20a-4a4e-8874-c72693a64492'", "model": {"lc": 1, "type": "constructor", "id": ["langchain", "chat_models", "openai", "ChatOpenAI"], "kwargs": {"model_name": "kt-gpt-oss-rh014", "temperature": 0.0, "openai_api_key": {"lc": 1, "type": "secret", "id": ["OPENAI_API_KEY"]}, "openai_api_base": "https://dev.kora.kt.co.kr/v2", "request_timeout": 180.0, "max_retries": 2}, "name": "ChatOpenAI"}}
